From 122c998226f166a37702c13a8a173d0cfa9ec564 Mon Sep 17 00:00:00 2001
From: Alex Koutmos <akoutmos@gmail.com>
Date: Wed, 25 Nov 2026 12:28:32 -0600
Subject: [PATCH] Panic instead of aborting on allocations larger than 1 GiB

A failed allocation aborts the process, which nothing can recover from.
Typst's strings and arrays are `EcoString`s and `EcoVec`s, and a
document can ask for one as large as it likes: `"x" * n`, `range(n)`, or
`a * b` when a string was passed for `a`, with `n` from the document's
data. For an application that renders documents with untrusted data in a
long-running process (a web server, or the Erlang VM through a NIF), one
such document takes the whole process down, even when the allocation was
absurd (exabytes) and could never have succeeded.

`EcoVec::grow` now panics when an allocation would be larger than 1 GiB,
the way it already panics on a capacity overflow: before anything
changed, so the vector stays valid. Applications that catch panics (as
Typst's own tooling can) report an error instead of ending.

1 GiB is a policy choice, far above what documents need. It could be
made configurable if a fixed limit doesn't suit other users of the
crate.
---
 src/vec.rs     | 18 ++++++++++++++++++
 tests/tests.rs | 18 ++++++++++++++++++
 2 files changed, 36 insertions(+)

diff --git a/src/vec.rs b/src/vec.rs
index c28facf..a806103 100644
--- a/src/vec.rs
+++ b/src/vec.rs
@@ -541,6 +541,16 @@ impl<T> EcoVec<T> {
             capacity_overflow();
         }
 
+        // Refuse allocations larger than `MAX_ALLOCATION` by panicking, before
+        // anything changed, as for a capacity overflow. A failed allocation
+        // aborts the process, which callers can't recover from, and a vector or
+        // string this large is almost always the result of a runaway
+        // computation, such as repeating a string a number of times that came
+        // from untrusted data.
+        if mem::size_of::<T>().saturating_mul(target) > MAX_ALLOCATION {
+            allocation_too_large();
+        }
+
         // Directly go to maximum capacity for ZSTs.
         if mem::size_of::<T>() == 0 {
             target = isize::MAX as usize;
@@ -1227,6 +1237,14 @@ fn capacity_overflow() -> ! {
     panic!("capacity overflow");
 }
 
+/// The largest allocation an `EcoVec` (and so an `EcoString`) may make: 1 GiB.
+const MAX_ALLOCATION: usize = 1 << 30;
+
+#[cold]
+fn allocation_too_large() -> ! {
+    panic!("allocation larger than 1 GiB");
+}
+
 #[cold]
 fn ref_count_overflow<T>(ptr: NonNull<T>, len: usize) -> ! {
     // Drop to decrement the ref count to counter the increment in `clone()`
diff --git a/tests/tests.rs b/tests/tests.rs
index 343b0c5..d472efa 100644
--- a/tests/tests.rs
+++ b/tests/tests.rs
@@ -18,6 +18,24 @@ fn v<T>(value: T) -> Box<T> {
     Box::new(value)
 }
 
+#[test]
+#[should_panic(expected = "allocation larger than 1 GiB")]
+fn test_huge_string_panics() {
+    let _ = EcoString::from("x").repeat(1 << 40);
+}
+
+#[test]
+#[should_panic(expected = "allocation larger than 1 GiB")]
+fn test_huge_vec_panics() {
+    let _ = EcoVec::<u64>::with_capacity(1 << 28);
+}
+
+#[test]
+fn test_large_vec_is_allowed() {
+    let vec = EcoVec::<u8>::with_capacity(1 << 20);
+    assert!(vec.capacity() >= 1 << 20);
+}
+
 #[test]
 fn test_mem_size() {
     let word = mem::size_of::<usize>();
